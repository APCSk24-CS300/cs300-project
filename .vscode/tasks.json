{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker compose up",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/.vscode/compose-up.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "isBackground": true,
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "code-review-graph watch",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/code-review-graph.exe",
            "args": ["watch"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated"
            }
        }
    ]
}
