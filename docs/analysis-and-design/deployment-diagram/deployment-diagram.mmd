%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, sans-serif", "background": "#ffffff"}, "c4": {"diagramMarginX": 30, "diagramMarginY": 30, "c4ShapeMargin": 45, "c4ShapePadding": 20}}}%%
C4Deployment
    title Deployment Diagram for myHCMUS

    %% Deployment assumption: Vercel hosts the Next.js frontend.
    %% The Express API and PostgreSQL run on a separate Docker-capable host.
    %% Docker services, ports and storage follow src/docker-compose.yml.

    Deployment_Node(device, "User device", "Desktop or mobile") {
        Deployment_Node(browser, "Web browser", "Chrome / Firefox / Safari / Edge") {
            Container(client, "myHCMUS client", "React / TypeScript", "Student, organizer, and administrator UI")
        }
    }

    Deployment_Node(frontendHost, "Frontend hosting", "Vercel", "Cloud hosting platform") {
        Container(web, "Next.js web application", "Next.js 16 / React 19 / TypeScript", "Serves pages and static assets;<br/>runs server-side code and mock login route")
    }

    Deployment_Node(host, "Backend and database host", "Separate Docker-capable server / VM") {
        Deployment_Node(compose, "Docker Compose", "Project: myHCMUS", "Default shared network; services: server and db") {
            Deployment_Node(serverContainer, "myHCMUS-server", "Docker container / node:22") {
                Container(api, "Backend API", "Node.js 22 / Express 5 / TypeScript", "HTTP port 8080; /api/auth and /health<br/>Current startup: npm start / nodemon")
            }
            Deployment_Node(dbContainer, "myHCMUS-db", "Docker container / postgres:18") {
                ContainerDb(db, "Application database", "PostgreSQL 18", "Service address: db:5432<br/>Host port published: 5432")
            }
            Container(storage, "Persistent database storage", "Docker named volume: myHCMUS-db", "Mounted at /var/lib/postgresql")
        }
    }

    Rel(client, web, "Loads pages and assets", "HTTPS")
    Rel(client, api, "Planned API integration", "REST / JSON over HTTP :8080")
    Rel(api, db, "Reads and writes data", "pg / TCP :5432")
    Rel(db, storage, "Persists database files", "Volume mount")

    %% Blue: browser UI; amber: Vercel frontend; teal: implemented API;
    %% violet: database and persistence. Relationship labels carry status too.
    UpdateElementStyle(client, $bgColor="#DBEAFE", $fontColor="#172554", $borderColor="#2563EB")
    UpdateElementStyle(web, $bgColor="#FEF3C7", $fontColor="#78350F", $borderColor="#D97706")
    UpdateElementStyle(api, $bgColor="#CCFBF1", $fontColor="#134E4A", $borderColor="#0D9488")
    UpdateElementStyle(db, $bgColor="#EDE9FE", $fontColor="#4C1D95", $borderColor="#7C3AED")
    UpdateElementStyle(storage, $bgColor="#F5F3FF", $fontColor="#4C1D95", $borderColor="#8B5CF6")

    UpdateRelStyle(client, web, $textColor="#92400E", $lineColor="#D97706", $offsetX="-10", $offsetY="140")
    UpdateRelStyle(client, api, $textColor="#475569", $lineColor="#64748B", $offsetY="45")
    UpdateRelStyle(api, db, $textColor="#115E59", $lineColor="#0D9488", $offsetX="-15", $offsetY="100")
    UpdateRelStyle(db, storage, $textColor="#5B21B6", $lineColor="#7C3AED", $offsetY="-20")

    UpdateLayoutConfig($c4ShapeInRow="1", $c4BoundaryInRow="3")
