# Frontend settings. Copy to .env.local and fill in. Never commit .env.local.

# Signs the mock session cookie (any long random string).
SESSION_SECRET=

# "mock" (default) uses in-browser mock data; "api" calls the backend.
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL the browser uses for API calls. In api mode use the forwarding route below.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Server-side only: where /api/backend forwards to (backend REST API base, /api/v1).
BACKEND_API_URL=http://localhost:8080/api/v1

# DEV ONLY, temporary until the Authentication group issues backend tokens (specs/004 research R-01).
# Backend token used by /api/backend for every request, made with:
#   cd src/server && node scripts/mint-dev-token.ts <userId>     (e.g. SEED-ADMIN or SEED-STUDENT-1)
# Swap it to see the hub as another role, then restart `npm run dev`.
DEV_BACKEND_TOKEN=
