# Frontend settings. Copy to .env.local and adjust. Never commit .env.local.
# Restart `npm run dev` after any change (Next reads env files at startup).

# Data source: "mock" (MSW in the browser, default) or "real" (the backend).
NEXT_PUBLIC_API_MODE=mock

# Base URL the browser calls.
# mock: the contract URL (docs/api/openapi.yaml servers[0]); MSW intercepts this same URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# real: the same-origin forwarder (the backend has no CORS), so use instead:
# NEXT_PUBLIC_API_BASE_URL=/api/backend

# Server-side only: where /api/backend forwards to (backend REST API base, /api/v1).
BACKEND_API_URL=http://localhost:8080/api/v1

# DEV ONLY, opt-in. The forwarder passes the signed-in user's bearer token to the backend.
# Only when ALLOW_DEV_BACKEND_TOKEN=true, NODE_ENV is not production AND a request has no
# Authorization header, it uses DEV_BACKEND_TOKEN instead (and logs a warning). Mint one with:
#   cd src/server && node scripts/mint-dev-token.ts <userId>     (e.g. SEED-ADMIN or SEED-STUDENT-1)
ALLOW_DEV_BACKEND_TOKEN=false
DEV_BACKEND_TOKEN=
