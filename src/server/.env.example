BACKEND_PORT=

# Required: login cannot sign tokens without it. Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Database: in Compose the server also reads db/.env (POSTGRES_USER / POSTGRES_PASSWORD), and compose sets
# POSTGRES_DB=myHCMUS (the database schema.sql creates). The host is the Compose service "db".
# Fill these only when running the server outside Compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=myHCMUS

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BACKUP_MODEL=gemini-2.5-flash

# AI module (specs/003-ai-assistant-safety). Leave secrets empty here; set them in .env only.
AI_HISTORY_SECRET=
AI_DB_USER=ai_gateway
AI_DB_PASSWORD=
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Store avatar image files outside PostgreSQL. Mount a persistent volume at this path in deployed environments.
AVATAR_STORAGE_DIRECTORY=./data/avatars
