BACKEND_PORT=

JWT_SECRET=

DATABASE_URL=postgresql://app_user:your_password@db:5432/app_db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BACKUP_MODEL=gemini-2.5-flash

# AI module (specs/003-ai-assistant-safety). Leave secrets empty here; set them in .env only.
AI_HISTORY_SECRET=
AI_DB_USER=ai_gateway
AI_DB_PASSWORD=
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Store avatar image files outside PostgreSQL. Mount a persistent volume at this path in deployed environments.
AVATAR_STORAGE_DIRECTORY=./data/avatars
