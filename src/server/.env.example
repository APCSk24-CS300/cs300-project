BACKEND_PORT=

JWT_SECRET=

# Optional PostgreSQL URL. Set this for Supabase; leave blank to use POSTGRES_* values.
DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BACKUP_MODEL=gemini-2.5-flash

# AI module (specs/003-ai-assistant-safety). Leave secrets empty here; set them in .env only.
AI_HISTORY_SECRET=
AI_DB_USER=ai_gateway
AI_DB_PASSWORD=
# Optional URL for the AI least-privilege role on Supabase.
AI_DATABASE_URL=
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
